{
  "name": "@paolojulian.dev/design-system-mcp",
  "version": "0.1.0",
  "description": "MCP server for @paolojulian.dev/design-system: search components, props, tokens, and theming guidance from an AI agent.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "design-system-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/catalog/build.*",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node dist/catalog/build.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "~5.6.2"
  }
}
